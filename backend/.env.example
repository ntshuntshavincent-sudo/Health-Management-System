# ─────────────────────────────────────────────────────────────────────────────
# HealthRecord API — environment configuration
# Copy this file to `.env` and fill in your own values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Two options — DATABASE_URL wins if it is set.
# Option A: single connection string (used by most hosting providers)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/healthrecord
#
# Option B: individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthrecord
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=10

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Tokens last one working shift (8 hours) by default.
JWT_SECRET=change_me_to_a_long_random_secret_string_minimum_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Rate limiting (requests per window)
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
LOOKUP_MAX_PER_MINUTE=60
GENERAL_MAX_PER_MINUTE=200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production only).
FRONTEND_URLS=http://localhost:3001

# ── Patient kiosk (public touchscreen in the waiting room) ────────────────────
# Optional shared secret. If set, /api/kiosk/lookup requires an X-Kiosk-Key
# header, so the endpoint cannot be called from any random PC on the network.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KIOSK_API_KEY=
# Always keep this true in production: an anonymous kiosk sees name + appointment only.
KIOSK_MINIMISE=true

# ── Data retention (POPIA / National Health Act) ──────────────────────────────
# Medical records are kept for at least 6 years past the last entry.
RETENTION_YEARS=6

# ── First-run bootstrap (used by `npm run seed` only) ─────────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULLNAME=System Administrator
